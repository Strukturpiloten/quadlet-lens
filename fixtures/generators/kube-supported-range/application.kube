[Kube]
Yaml=./quadlet-lens-placeholder.yaml
ConfigMap=/run/quadlet-lens/configmap-placeholder.yaml
ContainersConfModule=pre.conf
ContainersConfModule=
ContainersConfModule=post.conf
GlobalArgs=--log-level=debug
GlobalArgs=
GlobalArgs=--events-backend=file
AutoUpdate=registry
AutoUpdate=local
ExitCodePropagation=any
KubeDownForce=true
LogDriver=k8s-file
LogOpt=path=/run/quadlet-lens/kube.log
LogOpt=max-size=1m
Network=frontend.network
PodmanArgs=--replace
PodmanArgs=
PodmanArgs=--userns=keep-id
PublishPort=8080:80
ServiceName=quadlet-lens-kube
SetWorkingDirectory=yaml
UserNS=keep-id
