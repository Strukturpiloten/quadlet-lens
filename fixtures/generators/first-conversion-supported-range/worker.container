[Unit]
Requires=app.service
After=app.service

[Container]
Image=registry.example.invalid/worker:1.0@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
Exec=/usr/bin/true
EnvironmentFile=./worker.env
EnvironmentFile=/etc/quadlet-lens/worker.env
Pod=application.pod
HealthCmd=/usr/bin/true
Notify=healthy
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=10s
HealthTimeout=5s
