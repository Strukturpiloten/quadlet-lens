[Unit]
Requires=app.service
After=app.service

[Container]
Image=registry.example.invalid/worker:1.0@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
Exec=/usr/bin/true
EnvironmentFile=./worker.env
EnvironmentFile=/etc/quadlet-lens/worker.env
Secret=worker-password,target=password,uid=1001,gid=1002,mode=0440
Secret=worker-token,type=env,target=WORKER_TOKEN
User=1001
Group=1002
UserNS=keep-id
GroupAdd=audio
GroupAdd=44
WorkingDir=/srv/app
ReadOnly=true
Pod=application.pod
StopSignal=SIGUSR1
StopTimeout=37
HealthCmd=/usr/bin/true
Notify=healthy
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=10s
HealthTimeout=5s
