[Unit]
Requires=app.service
After=app.service

[Container]
Image=registry.example.invalid/worker:1.0@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
Exec=/usr/bin/true
EnvironmentFile=./worker.env
EnvironmentFile=/etc/quadlet-lens/worker.env
User=1001
Group=1002
UserNS=keep-id
GroupAdd=audio
GroupAdd=44
WorkingDir=/srv/app
ReadOnly=true
Pod=application.pod
HealthCmd=/usr/bin/true
Notify=healthy
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=10s
HealthTimeout=5s
