[Unit]
Description=Generator matrix application

[Container]
ContainerName=quadlet-lens-app
AddHost=host.docker.internal:host-gateway
AddHost=database:192.0.2.10
Image=registry.example.invalid/application:1.0@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
Entrypoint=["/usr/bin/env","sh"]
RunInit=true
Exec=/usr/bin/true
Environment=APP_HOME=%h/application
Environment="QUADLET_LENS_SPACE=hello world"
Environment="QUADLET_LENS_QUOTE=hello \"quoted\""
Environment="QUADLET_LENS_BACKSLASH=path\\literal"
Environment="QUADLET_LENS_DOLLAR=$literal"
Environment="QUADLET_LENS_EQUALS=left=right"
Environment="QUADLET_LENS_UNICODE=café"
Environment="QUADLET_LENS_EMPTY="
Label=io.github.strukturpiloten.quadlet-lens.fixture=app
Label=io.github.strukturpiloten.quadlet-lens.repeat=second
Label=io.github.strukturpiloten.quadlet-lens.empty=
Label="io.github.strukturpiloten.quadlet-lens.metadata={\"channel\": \"stable\"}"
PublishPort=8080
PublishPort=18081:8081
PublishPort=127.0.0.1:18080:8080
PublishPort=20000-20002:30000-30002
Volume=data.volume:/var/lib/application:Z
Volume=./config:/etc/application:ro,Z
Volume=/var/lib/application-anonymous
Network=app.network
Network=quadlet-lens-external
PodmanArgs=--label first=value \
# Comments in a continuation are not command arguments.
  --label second=value

[Service]
Restart=on-failure
