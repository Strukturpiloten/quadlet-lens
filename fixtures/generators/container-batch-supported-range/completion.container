[Container]
Image=registry.example.invalid/container-completion:1
ContainersConfModule=pre-one.conf
ContainersConfModule=pre-two.conf
ContainersConfModule=
ContainersConfModule=post-one.conf
ContainersConfModule=post-two.conf
GlobalArgs=--log-level=info
GlobalArgs=
GlobalArgs=--log-level=debug
HealthCmd=echo
HealthLogDestination=local
HealthMaxLogCount=5
HealthMaxLogSize=10m
HealthStartupCmd=echo
HealthStartupInterval=2s
HealthStartupRetries=4
HealthStartupSuccess=2
HealthStartupTimeout=1s
ServiceName=ignored-first
ServiceName=completion-chosen
