{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "dependencyDashboard": true,
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/fixtures/**"
  ],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "timezone": "Europe/Berlin",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Discover the newest stable Podman release across minor lines",
      "managerFilePatterns": ["/^tools/generator-matrix\\.toml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) packageName=(?<packageName>[^\\s]+) depName=(?<depName>podman-upstream)\\nlatest_upstream = \\\"(?<currentValue>[^\\\"]+)\\\""
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Discover the newest stable Podman patch independently for each maintained minor line",
      "managerFilePatterns": ["/^tools/generator-matrix\\.toml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) packageName=(?<packageName>[^\\s]+) depName=(?<depName>podman-[0-9]+\\.[0-9]+)\\nlatest_[0-9]+_[0-9]+ = \\\"(?<currentValue>[^\\\"]+)\\\""
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Update the generator Go builder version and digest together",
      "managerFilePatterns": ["/^tools/generator-matrix\\.toml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\nbuilder_reference = \\\"[^:\\\"]+:(?<currentValue>[^@\\\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\\\""
      ]
    },
    {
      "customType": "regex",
      "description": "Update versioned Dev Container tools",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\nARG [A-Z0-9_]+_VERSION=(?<currentValue>[^\\s]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Signal updates for checksum-pinned file-quality tools",
      "managerFilePatterns": ["/^scripts/install-file-tools\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\nreadonly [a-z0-9_]+_version=\"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Update directly pinned workflow tool versions",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n\\s+version: \"(?<currentValue>[^\"]+)\"",
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n\\s+node-version: (?<currentValue>[^\\s]+)",
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n\\s+run: cargo install --locked --version (?<currentValue>[^\\s]+) [^\\s]+"
      ]
    },
    {
      "customType": "regex",
      "description": "Update the Dev Container base release and digest together",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n# release: (?<currentValue>[^\\s]+)\\nFROM [^\\s]+@(?<currentDigest>sha256:[a-f0-9]{64})"
      ]
    },
    {
      "customType": "regex",
      "description": "Update the documented Dev Container CLI",
      "managerFilePatterns": ["/^docs/development-environment\\.md$/"],
      "matchStrings": ["@devcontainers/cli@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "@devcontainers/cli"
    },
    {
      "customType": "regex",
      "description": "Update the GitHub CLI installed in the Dev Container",
      "managerFilePatterns": ["/^\\.devcontainer/devcontainer\\.json$/"],
      "matchStrings": [
        "\"ghcr\\.io/devcontainers/features/github-cli:[^\"]+\"[\\s\\S]*?\"version\": \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "cli/cli"
    },
    {
      "customType": "regex",
      "description": "Track the immutable Strukturpiloten shared-policy commit",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "(?<indentation>[ \\t]*)# renovate: datasource=github-digest depName=(?<depName>Strukturpiloten/\\.github) currentValue=(?<currentValue>main)\\n[ \\t]*ref:\\s*(?<currentDigest>[a-f0-9]{40})"
      ],
      "datasourceTemplate": "github-digest",
      "autoReplaceStringTemplate": "{{{indentation}}}# renovate: datasource=github-digest depName={{{depName}}} currentValue={{{newValue}}}\n{{{indentation}}}ref: {{{newDigest}}}"
    }
  ],
  "packageRules": [
    {
      "description": "Group compatible Rust dependency updates",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "groupName": "Rust dependencies"
    },
    {
      "description": "Group repository Node development-tool updates",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "Node development tools"
    },
    {
      "description": "Pin every GitHub Action to an immutable commit hash",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "pinDigests": true
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Automerge tested non-major dependency updates",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": "Automerge green-gated lock-file maintenance",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": "0 days",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": "Do not delay BoxFerry and Lens releases",
      "matchPackageNames": [
        "boxferry",
        "boxferry-model",
        "boxferry-engine",
        "boxferry-compose",
        "boxferry-podman",
        "boxferry-quadlet",
        "compose-lens",
        "podman-lens",
        "quadlet-lens"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Keep newest-upstream and maintained-minor Podman discovery separate from reviewed support",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["podman-container-tools/podman"],
      "matchFileNames": ["tools/generator-matrix.toml"],
      "automerge": false,
      "prBodyNotes": [
        "This updates a Podman discovery signal only. Advancing an active generator pin, tracked_current, catalogue or application contract requires reviewed source and generator evidence."
      ]
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["podman-upstream"],
      "allowedVersions": "/^[0-9]+\\.[0-9]+\\.[0-9]+$/"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["podman-5.4"],
      "allowedVersions": "/^5\\.4\\.[0-9]+$/"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["podman-5.5"],
      "allowedVersions": "/^5\\.5\\.[0-9]+$/"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["podman-5.6"],
      "allowedVersions": "/^5\\.6\\.[0-9]+$/"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["podman-5.7"],
      "allowedVersions": "/^5\\.7\\.[0-9]+$/"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["podman-5.8"],
      "allowedVersions": "/^5\\.8\\.[0-9]+$/"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["podman-6.0"],
      "allowedVersions": "/^6\\.0\\.[0-9]+$/"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["podman-6.1"],
      "allowedVersions": "/^6\\.1\\.[0-9]+$/"
    },
    {
      "description": "Keep Dev Container feature versions current; the lock file owns digests",
      "matchManagers": ["devcontainer"],
      "matchDepTypes": ["feature"],
      "pinDigests": false,
      "groupName": "Dev Container",
      "automerge": false,
      "prBodyNotes": [
        "Regenerate and commit the Dev Container feature lock as documented in docs/development-environment.md."
      ]
    },
    {
      "description": "Keep Rust toolchain updates visible and separate",
      "matchManagers": ["rust-toolchain"],
      "groupName": "Rust toolchain"
    },
    {
      "description": "Require checksum review for downloaded file-quality tools",
      "matchFileNames": ["scripts/install-file-tools.sh"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "prBodyNotes": [
        "Review both Linux release assets and update their SHA-256 checksums before merging."
      ]
    }
  ]
}
